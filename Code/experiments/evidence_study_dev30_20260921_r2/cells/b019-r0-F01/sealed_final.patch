+    def _vel_dict_from_pos(self, frame):
+        """Calculate the velocity of this point in the provided frame from
+        the relative positions of points, if possible.
+
+        This is used by :meth:`vel` to automatically determine the velocity
+        when it has not been explicitly set, analogous to how
+        :meth:`ReferenceFrame.ang_vel_in` determines angular velocity from
+        the relative orientations of reference frames.
+        """
+        for point in self._pos_dict:
+            try:
+                vel = point._vel_dict[frame]
+            except KeyError:
+                continue
+            return vel + self._pos_dict[point].dt(frame)
+        raise ValueError('Velocity of point ' + self.name + ' has not been'
+                         ' defined in ReferenceFrame ' + frame.name)
+
